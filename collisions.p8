pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
--bullet invader collision logic
function check_collisions()
 for b in all(bullets) do
  for i in all(invaders) do
   if abs(b.x-i.x)<5 and abs(b.y-i.y)<5 then
    del(bullets,b) 
    play_enemy_destroy()  --destroy sfx
    del(invaders,i)--both deleted when collision is true
   	add(popups, {
				 x = i.x,
				 y = i.y,
				 text = "+"..(1+level),
				 t = 30
					})
    score += 1+level
    break -- stops checking after a hit
   end
  end
 end
end
